# Postly's origin; for a hosted installation use the deployed HTTPS origin.
APP_BASE_URL=http://localhost:4174
# Network interface for the API server. Docker sets this to 0.0.0.0 internally.
HOST=127.0.0.1
# Optional OAuth callback origin override. Leave blank to use APP_BASE_URL.
OAUTH_REDIRECT_BASE=

# Optional public HTTPS origin used only when Instagram or TikTok needs to fetch media.
# Use a public DNS hostname on HTTPS port 443 with no path, query, or credentials.
# The reverse proxy must serve /api/social/media/<id> without sign-in. Do not use localhost.
PUBLIC_MEDIA_BASE_URL=

# Optional absolute, private, writable media directory. Defaults to POSTLY_DATA_DIR/media.
# Use persistent shared storage if more than one server instance handles publishing.
PUBLIC_MEDIA_STORAGE_DIR=

# Optional private data directory; defaults to .postly-data.
POSTLY_DATA_DIR=

# Meta Graph API version used for Instagram publishing (default: v26.0).
META_GRAPH_API_VERSION=v26.0

# Generate with: openssl rand -hex 32. Required when NODE_ENV=production.
TOKEN_ENCRYPTION_KEY=

# Instagram Login API app credentials
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok for Developers app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google OAuth web client credentials with YouTube Data API enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
