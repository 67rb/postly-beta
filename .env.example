# Postly's public base URL. For production this must be your deployed HTTPS origin.
APP_BASE_URL=http://localhost:4174
# Optional OAuth callback origin override. Leave blank to use the current app origin.
OAUTH_REDIRECT_BASE=

# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Instagram Login API app credentials
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok for Developers app credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google OAuth web client credentials with YouTube Data API enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
