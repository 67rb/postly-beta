# Point this DNS name at the public IP of the Docker host.
POSTLY_DOMAIN=postly.example.com

# Caddy protects the app/API with HTTP Basic Auth.
POSTLY_BASIC_AUTH_USER=postly
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the resulting bcrypt hash single-quoted in .env.production because it contains dollar signs.
POSTLY_BASIC_AUTH_HASH='$2a$14$replace-this-with-a-generated-hash'

# Generate once with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Fill these after creating each provider app. Do not commit the populated .env.production file.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional; defaults to v26.0.
META_GRAPH_API_VERSION=v26.0
